# ============================================================================
# CitationalAI — Query Pool (worker + scheduler)
# Contact: steve@citational.ai
# ============================================================================

# --- Railway Postgres ---
# Railway injects DATABASE_URL automatically when Postgres is provisioned in
# the same project. Only set this manually for local dev against a Railway
# instance or a local Postgres.
DATABASE_URL=postgres://user:password@host:5432/citational

# --- Railway Redis (job queue backing store — BullMQ) ---
# Railway injects REDIS_URL automatically when Redis is provisioned in the
# same project. Only set manually for local dev.
REDIS_URL=redis://user:password@host:6379

# --- Channel: Google AI Mode (via DataForSEO) ---
# https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_NAME=United States
DATAFORSEO_LANGUAGE_NAME=English
DATAFORSEO_DEVICE=desktop
DATAFORSEO_OS=windows

# --- Channel: ChatGPT ---
# UNVERIFIED ASSUMPTION — see README "Channel caveats". There is no public
# API that queries the ChatGPT consumer product directly; this uses the
# OpenAI Chat Completions API as a proxy signal, which is not the same thing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Channel: Perplexity ---
# https://docs.perplexity.ai
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- Classification pass (state + competitor_brand extraction) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Safety valves ---
# Smoke-test without spending anything or writing to the DB.
DRY_RUN=false
# Hard cap on queries per enqueue call while validating cost/behaviour.
# 0 or unset = no cap.
MAX_QUERIES_PER_RUN=0

# --- Scheduler cadence (cron expressions, UTC) ---
# Phase 1 (pool validation, pre-merchant): one weekly pool-wide run.
# Kept as an env var so Phase 2 can split Free (weekly) vs Essential (daily)
# without a code change — see README "Phase 2 note".
POOL_CRON=0 6 * * 1
