# ============================================================================
# CitationalAI — Query Pool (worker + scheduler)
# Contact: steve@citational.ai
# ============================================================================

# --- Railway Postgres ---
DATABASE_URL=postgres://user:password@host:5432/citational

# --- Railway Redis (job queue backing store — BullMQ) ---
REDIS_URL=redis://user:password@host:6379

# --- Channel: Google AI Mode (via DataForSEO) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_NAME=United States
DATAFORSEO_LANGUAGE_NAME=English
DATAFORSEO_DEVICE=desktop
DATAFORSEO_OS=windows

# --- Channel: ChatGPT ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Channel: Perplexity ---
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- Classification pass (mentions extraction) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Safety valves ---
DRY_RUN=false
MAX_QUERIES_PER_RUN=0

# --- API service (Railway service #3) ---
PORT=3000
# Needed for GDPR webhook HMAC verification — doesn't exist yet, since no
# real Shopify app/OAuth flow has been built. Leave unset until then;
# webhook routes will correctly reject everything with 401 until it's set,
# which is the safe default.
SHOPIFY_API_SECRET=

# --- Alerting ---
# Resend (https://resend.com) — free tier covers this easily (3,000
# emails/month). onboarding@resend.dev works immediately with zero setup;
# verifying citational.ai as the sending domain is a later nice-to-have,
# not required to get started.
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev
ALERT_EMAIL_TO=steve@citational.ai
# Shared secret for Railway's own deploy-failure webhook — set this here
# AND use the same value in the webhook URL configured in Railway's
# dashboard (Project Settings -> Webhooks): .../internal/railway-webhook?secret=...
RAILWAY_WEBHOOK_SECRET=
# How often the scheduler checks for silent crashes / error-rate spikes —
# things Railway's own alerting can't see. Default: every 6 hours.
HEALTH_CHECK_CRON=0 */6 * * *

# --- Scheduler cadence (cron expressions, UTC) ---
POOL_CRON=0 6 * * 1
