{
  "name": "citational-pool",
  "version": "0.1.0",
  "private": true,
  "description": "CitationalAI — shared query pool: worker + scheduler (Railway, Postgres, Redis/BullMQ)",
  "type": "module",
  "scripts": {
    "worker": "node src/worker.js",
    "scheduler": "node src/scheduler.js",
    "enqueue": "node src/scripts/enqueuePoolRun.js",
    "enqueue:dry": "DRY_RUN=true node src/scripts/enqueuePoolRun.js",
    "migrate": "node src/scripts/migrate.js",
    "migrate:v2": "node src/scripts/migrate_v2.js",
    "migrate:v3": "node src/scripts/migrate_v3.js",
    "migrate:v4": "node src/scripts/migrate_v4.js",
    "migrate:v5": "node src/scripts/migrate.v5.js",
    "dedupe": "node src/scripts/dedupe.js",
    "search-volume": "node src/scripts/fetchSearchVolume.js",
    "api": "node src/api/server.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0"
  }
}
